# =====================================================
# Compiler & Global Flags for macOS
# =====================================================
CXX      := clang++
CXXFLAGS := -std=c++23 -O3 -march=native -ffast-math -ffp-contract=fast -funroll-loops -fvectorize -w

# Homebrew Includes and Libs
HOMEBREW_INCLUDES := -I/opt/homebrew/include -I/opt/homebrew/include/jsoncpp
HOMEBREW_LIBS     := -L/opt/homebrew/lib -ljsoncpp -lgdal -lpng16

# OpenMP configuration for Apple Clang
OMP_FLAGS := -Xpreprocessor -fopenmp -I/opt/homebrew/opt/libomp/include
OMP_LIBS  := -L/opt/homebrew/opt/libomp/lib -lomp

# HDF5 - needed anywhere GaEngine's HDF5-writing code (H5Dclose/H5Fopen/etc.)
# gets linked in, i.e. wherever GaEngine itself is compiled in - currently
# just the "ga" target, but if GaEngine ends up part of "tool" too (it
# looked like it might be, based on the last linker error), this needs to
# be added there as well.
HDF5_LIBS := -L/opt/homebrew/opt/hdf5/lib -lhdf5

# macOS Linker Dead-Code Stripping (Replaces Linux --gc-sections)
MAC_LDFLAGS := -Wl,-dead_strip

# Dynamic configuration flags via packages
GDAL_CFLAGS := $(shell gdal-config --cflags)
GDAL_LIBS   := $(shell gdal-config --libs)

JSON_CFLAGS := $(shell pkg-config --cflags jsoncpp)
JSON_LIBS   := $(shell pkg-config --libs jsoncpp)

PNG_CFLAGS  := $(shell pkg-config --cflags libpng)
PNG_LIBS    := $(shell pkg-config --libs libpng)

# Common Preprocess Shared Sources
PREPROCESS_SRC := preprocess/jsonParser.cc preprocess/reproject.cc preprocess/lib/*.cc

.PHONY: all bin test tool deploy multi-radar-deployment astar single-radar-deployment gen_bin clean

all: tool

# =====================================================
# Main Trace CLI (with Optimized OpenMP parallel processing)
# =====================================================
tool:
	$(CXX) $(CXXFLAGS) -flto $(OMP_FLAGS) \
	$(HOMEBREW_INCLUDES) \
	$(JSON_CFLAGS) $(PNG_CFLAGS) $(GDAL_CFLAGS) \
	cli/main.cc \
	multi-radar-deployment/config.cc \
	common/lineofsight.cc \
	common/image.cc \
	common/coverage.cc \
	common/angleviewshed.cc \
	common/radarlos.cc \
	common/operations.cc \
	preprocess/preprocess.cc \
	render.cc \
	$(PREPROCESS_SRC) \
	-o trace \
	$(JSON_LIBS) $(PNG_LIBS) $(GDAL_LIBS) \
	$(OMP_LIBS) $(HDF5_LIBS) \
	-fdata-sections -ffunction-sections \
	$(MAC_LDFLAGS)

# =====================================================
# Genetic Algorithm (GA) Build with HDF5
# =====================================================
multi-radar-deployment:
	$(CXX) $(CXXFLAGS) $(OMP_FLAGS) multi-radar-deployment/main.cc \
	multi-radar-deployment/config.cc \
	common/coverage.cc \
	$(PREPROCESS_SRC) \
	$(HOMEBREW_INCLUDES) \
	$(GDAL_CFLAGS) \
	-o x_ga \
	$(HOMEBREW_LIBS) $(HDF5_LIBS) $(OMP_LIBS)

# =====================================================
# Path Finder (A*)
# =====================================================
astar:
	$(CXX) $(CXXFLAGS) path-finder/astar.cc \
	$(HOMEBREW_INCLUDES) \
	$(GDAL_CFLAGS) \
	-o astar_run \
	-L/opt/homebrew/lib \
	-ljsoncpp $(GDAL_LIBS)

# =====================================================
# Create the output/ folder tree the tool expects to write into
# =====================================================
init:
	mkdir -p output/viewshed \
	output/radar \
	output/gbadws \
	output/radarfd \
	output/heatmap \
	output/ga \
	output/pso \
	output/astar \

# =====================================================
# Particle Swarm Optimization (PSO) Single Radar
# single-radar-deployment/pso.h is header-only (no main()) and is driven
# through the CLI tool's `run single` subcommand — build `tool` and run
# `./trace run single` instead of a standalone pso target.
# =====================================================
single-radar-deployment:
	@echo "PSO is header-only now; run './trace run single' after 'make tool' instead."

init:
	mkdir -p ./output/radar ./output/viewshed ./output/pso ./output/ga ./output/radarfd ./output/path ./output/simdata ./output/gbadws ./output/heatmap ./output/preprocess

# =====================================================
# Cleanup
# =====================================================
clean:
	rm -f preproc x_test trace x_deploy x_ga astar_run pso_run gen_bin ga-gbadws/tactical_planner_ga-gbadws
